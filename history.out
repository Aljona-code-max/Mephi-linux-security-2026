   21  stat /home/user1/mycat >> ~/stat.out
   22  echo "user1 ALL=(ALL) NOPASSWD: /bin/date, /usr/bin/timedatectl" > /etc/sudoers.d/user1-time
   23  chmod 440 /etc/sudoers.d/user1-time
   24  su - user1 -c 'sudo timedatectl set-time "2026-01-01 12:00:00"'
   25  timedatectl set-ntp false
   26  su - user1 -c 'sudo timedatectl set-time "2026-01-01 12:00:00"'
   27  date
   28  timedatectl set-ntp true
   29  cp /etc/sudoers.d/user1-time ~/sudoers.d_user1-time.out
