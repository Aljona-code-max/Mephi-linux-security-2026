    1  ps -eo pid,ruid,euid,comm | awk '$3 == 0 && $2 != 0'
    2  > ~/processes.out
    3  ps -eo pid,ruid,euid,comm | awk '$3 == 0 && $2 != 0' > ~/processes.out
    4  cat ~/processes.out
    5  cp /bin/cat ~/mycat
    6  chow root:root ~/mycat
    7  chown root:root /mycat
    8  cp /bin/chown /home/user1/mychown
    9  setcap cap_chown=+ep /home/user1/mychown
   10  getcap /home/user1/mychown
   11  touch /home/user1/testfile
   12  su - user1 -c '/home/user1/mychown root:root /home/user1/testfile'
   13  ls -l /home/user1/testfile
   14  stat /home/user1/mychown >> ~/stat.out
   15  getcap /home/user1/mychown >> ~/getcap.out
   16  cp /bin/cat /home/user1/mycat
   17  chown root:root /home/user1/mycat
